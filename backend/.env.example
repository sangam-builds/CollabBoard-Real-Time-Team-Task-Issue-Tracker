# Port (Render assigns PORT automatically, default: 4000 locally)
PORT=4000

# Database connections (Supabase / PostgreSQL)
# DATABASE_URL: Transaction pooled URL (used at runtime)
DATABASE_URL="postgresql://postgres:password@host:5432/postgres?pgbouncer=true"

# DIRECT_URL: Direct URL (used for migrations on Render/locally)
DIRECT_URL="postgresql://postgres:password@host:5432/postgres"

# JWT Secret & Expiry
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Allowed CORS origin(s) - Set to your Vercel frontend URL in production
# Example: https://collabboard-frontend.vercel.app
CLIENT_ORIGIN="http://localhost:5173"
